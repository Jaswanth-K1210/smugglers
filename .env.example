# Copernicus Data Space Ecosystem (Sentinel Hub) — https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Global Fishing Watch API token — https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# Target area of interest, "min_lon,min_lat,max_lon,max_lat" (WGS84)
AOI_BBOX=

# aisstream.io key for live ship positions on the console map — https://aisstream.io/apikeys
AISSTREAM_API_KEY=

# Local test account for the console (create it via the sign-up page)
TEST_ACCOUNT_NAME=
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Open Waters (aiscast) personal token: free, raises the area cap per request (optional) — https://openwaters.io/ais/
OPENWATERS_TOKEN=

# VesselAPI key (free tier: 150 calls/month; satellite lookups are paid credits) — https://vesselapi.com
VESSELAPI_KEY=
